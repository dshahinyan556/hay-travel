{
  "ConnectionStrings": {
    "ATTours": "Server=(LocalDB)\\MSSQLLocalDB;Database=ATTour;Trusted_Connection=True;Integrated Security = true;MultipleActiveResultSets=true"
  },
  "Cors": {
    "AllowedOrigins": "https://haytravel.netlify.app,https://hay-travel.vercel.app"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "ATTours",
    "Audience": "ATTours.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Upload": {
    "StoragePath": "",
    "MaxFileSizeBytes": 8000000,
    "MaxOriginalDimension": 4000,
    "CompressedMaxDimension": 1600,
    "WebpQuality": 75,
    "AllowedContentTypes": ["image/jpeg", "image/png", "image/webp"]
  },
  "Email": {
    "Provider": "Brevo",
    "SendGridApiKey": "",
    "BrevoApiKey": "",
    "FromEmail": "<EMAIL_FROM>",
    "FromName": "Hay Travel",
    "VerifyUrlBase": "https://haytravel.netlify.app/verify-email",
    "ResetUrlBase": "https://haytravel.netlify.app/reset-password",
    "EmailChangeConfirmUrlBase": "https://haytravel.netlify.app/confirm-email-change"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
